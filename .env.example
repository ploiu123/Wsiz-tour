# Ustawienia serwera gry (skopiuj do pliku .env i uzupełnij; .env nigdy nie trafia do repozytorium)
PORT=3000
# Folder z paczką gry (npm run build); serwer poda pliki gry i obsłuży tryb online pod jednym adresem
STATIC_DIR=dist
# Gdy gra jest na innym adresie niż serwer (np. podczas npm run dev), adresy dozwolone dla połączeń online
CORS_ORIGIN=http://localhost:5173
# Tempo botów (1 = normalne; testy używają np. 0.2, żeby gra szła szybciej)
# GAME_PACE=1
# Klucz aplikacji od uczelni (logowanie przez wirtualny dziekanat) dopiszemy, gdy dział IT poda standard logowania
# UCZELNIA_CLIENT_ID=
# UCZELNIA_CLIENT_SECRET=
