{
  "name": "wsiz-tour",
  "version": "0.9.0",
  "private": true,
  "description": "WSiZ Tour: gra planszowa 3D w przeglądarce o Wyższej Szkole Informatyki i Zarządzania w Bielsku-Białej (praca inżynierska)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sim": "node --experimental-strip-types --no-warnings scripts/symulacja.ts",
    "server": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "assets": "node tools/assets.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.4"
  }
}
